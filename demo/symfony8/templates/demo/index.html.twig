{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Wallet QR Bundle Demo', intro: 'Sample QR codes for Android (Google Wallet) and iOS (Apple Wallet) save/download links.'}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Android · Google Wallet', kind: 'detail', testid: 'demo-android'} %}
        {% block section_body %}
            <img src="{{ wallet_qr_data_uri(androidQr) }}" alt="Google Wallet QR" width="240" height="240">
            <p><code class="nowo-ui-code">{{ androidQr.link.url }}</code></p>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'iOS · Apple Wallet', kind: 'detail', testid: 'demo-ios'} %}
        {% block section_body %}
            <img src="{{ wallet_qr_data_uri(iosQr) }}" alt="Apple Wallet QR" width="240" height="240">
            <p><code class="nowo-ui-code">{{ iosQr.link.url }}</code></p>
        {% endblock %}
    {% endembed %}
{% endblock %}
