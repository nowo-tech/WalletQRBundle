{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Wallet QR Bundle Demo', intro: 'Sample QR codes for Android (Google Wallet) and iOS (Apple Wallet) save/download links.'}) }}
{% endblock %}

{% block body %}
    <div class="nowo-ui-cards">
        <section class="nowo-ui-card">
            <div class="nowo-ui-card__body">
                <h2 class="nowo-ui-card__title">Android · Google Wallet</h2>
                <img src="{{ wallet_qr_data_uri(androidQr) }}" alt="Google Wallet QR" width="240">
                <p><code class="nowo-ui-code">{{ androidQr.link.url }}</code></p>
            </div>
        </section>
        <section class="nowo-ui-card">
            <div class="nowo-ui-card__body">
                <h2 class="nowo-ui-card__title">iOS · Apple Wallet</h2>
                <img src="{{ wallet_qr_data_uri(iosQr) }}" alt="Apple Wallet QR" width="240">
                <p><code class="nowo-ui-code">{{ iosQr.link.url }}</code></p>
            </div>
        </section>
    </div>
{% endblock %}
