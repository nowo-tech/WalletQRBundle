# PHPStan configuration for Wallet QR Bundle
# Compatible with PHP 8.1+ and Symfony 6.x / 7.x / 8.x

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
        # Runtime class_alias files — symbols registered via bootstrapFiles for analysis
        - src/Exception/InvalidWalletQrUrlException.php
        - src/QrCode/QrCodeDataUriRenderer.php
        - src/Security/QrUrlPolicy.php
    bootstrapFiles:
        - phpstan-bootstrap.php
    # REQ-CS-006: never silence findings here — fix the code instead
    ignoreErrors: []

includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon
